# Server configuration
PORT=3000
# Admin credentials
ADMIN_PASSWORD=123321
# Gemini proxy
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# GitHub Sync (optional)
# GITHUB_PROJECT format must be: "username/repo-name" e.g., "username/repo-name"
GITHUB_PROJECT=
# GitHub Personal Access Token, requires repo scope
GITHUB_PROJECT_PAT=
# Database encryption key (32-character string used to encrypt GitHub sync data)
GITHUB_ENCRYPT_KEY=
# GitHub sync mode: commit (default) or replace-history
# replace-history force-resets the target branch to a single database snapshot.
# Use it only with a dedicated data repository or a dedicated sync branch.
GITHUB_SYNC_MODE=commit
# Optional branch for GitHub database sync. Recommended when using replace-history.
GITHUB_SYNC_BRANCH=
# Optional delayed upload interval after database changes, default 300 seconds.
GITHUB_SYNC_DELAY_SECONDS=300

# Proxy configuration (optional)
# Comma-separated list of SOCKS5 proxy URLs for API requests
# Example: PROXY=socks5://user:pass@proxy1.com:1080,socks5://proxy2.com:1080
PROXY=
