{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false
  },
  "include": ["public/admin/**/*.ts", "public/*.ts"],
  "exclude": ["node_modules", "dist"]
}
